# 이 파일을 .env로 복사해 씁니다. GITHUB_TOKEN 말고는 모두 선택 사항입니다.
# 앱 업데이트 기능이 비공개 저장소의 릴리스 APK를 읽는 토큰(Contents: Read-only)
GITHUB_TOKEN=
GITHUB_REPO=bj0322/PostechTimes
PORT=8787
HOST=0.0.0.0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
DATA_DIR=./data
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:3000
# 리버스 프록시 뒤에서 돌릴 때만 1
TRUST_PROXY=0
# 새 기사 확인 주기(분). 새 기사 알림과 미리 요약이 이 주기로 돈다.
WATCH_INTERVAL_MIN=5
# 사이트에 막히면(403·429·오류 페이지 리디렉션) 이 시간(분) 동안 요청하지 않음
BLOCK_PAUSE_MIN=60
# 섹션마다 최신 몇 건의 요약을 미리 만들지(0이면 끔). 새 기사는 이 값과 상관없이 요약한다.
PREFETCH_PER_SECTION=5
