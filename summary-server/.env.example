# 모두 선택 사항입니다. 값을 바꾸고 싶은 것만 환경 변수로 설정합니다.
PORT=8787
HOST=0.0.0.0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
DATA_DIR=./data
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:3000
# 리버스 프록시 뒤에서 돌릴 때만 1
TRUST_PROXY=0
# 새 기사를 미리 요약해 두는 기능. 섹션마다 최신 몇 건을 볼지(0이면 끔)와 확인 주기(분)
PREFETCH_PER_SECTION=5
PREFETCH_INTERVAL_MIN=30
